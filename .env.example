# CreatorAI Environment Configuration
# Copy this file to .env.local for local development, or add these keys to your Vercel Project Settings

# MongoDB Atlas connection string (placeholder)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/creatorai?retryWrites=true&w=majority

# Google Gemini API Key (Get key at: https://aistudio.google.com)
GEMINI_API_KEY=your_key_here

# Secure secret for signing creator JWT tokens (32+ random characters)
JWT_SECRET=your_jwt_secret_here

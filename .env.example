# CreatorAI Environment Configuration
# Copy this file to .env.local for local development, or add these keys to your Vercel Project Settings

# MongoDB Atlas connection string
MONGODB_URI=

# Google Gemini API Key (Get free key at: https://aistudio.google.com)
GEMINI_API_KEY=

# Secure secret for signing creator JWT tokens (Optional in dev, recommended in prod)
JWT_SECRET=
